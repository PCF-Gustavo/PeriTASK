{
	"_comentario": [
		"Para adicionar uma nova funcionalidade:",
		"1. Adicione um novo item em comandos (ver abaixo neste arquivo)",
		"2. O campo 'id' deve ser igual ao nome do arquivo Python em PythonScript/comandos",
		"3. O arquivo deve conter uma função executar(arquivos, controls, pasta_saida)"
	],

	"version": "1.0",

	"comandos": [
		{
			"id": "lista_caminhos_txt",
			"label": "Arquivos -> lista de caminhos em .txt"
		},
		{
			"id": "videos_csv_simplificado",
			"label": "Vídeos -> tabela simplificada de informações em .csv"
		},
		{
			"id": "videos_csv_completo",
			"label": "Vídeos -> tabela completa de informações em .csv"
		},
		{
			"id": "teste_id",
			"label": "teste",
			"ui": {
				"controls": [
					{
						"type": "checkbox",
						"id": "checkbox_teste_alerta1",
						"text": "Ativar alerta1",
						"enabled": true,
						"checked": false,
						"screenTip": "Mostra um MessageBox quando marcado 1",
						"position": {
							"row": 0,
							"column": 0
						}
					},
					{
						"type": "dropdown",
						"id": "dropdown_id",
						"text": "Escolha apenas 1:",
						"items": [
							"0",
							"1",
							"2"
						],
						"default": "1",
						"enabled": true,
						"screenTip": "Escolha uma opção.",
						"position": {
							"row": 1,
							"column": 0
						}
					},

					{
						"type": "editbox",
						"id": "editbox_quantidade",
						"text": "Quantidade:",
						"default": "10",
						"enabled": true,
						"regex": "^[1-9]\\d*$",
						"stringsize": 3,
						"displayWidth": 3,
						"screenTip": "Informe um número inteiro positivo.",
						"position": {
							"row": 2,
							"column": 0
						}
					}
				]
			}
		}
	]
}